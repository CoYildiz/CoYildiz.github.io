---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSeriesPosts } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";

const posts = await getSeriesPosts();

const no = (slug: string) => slug.match(/(?:^|-)(\d{2})-/)?.[1] ?? "";

// Konu blokları: [başlık, açıklama, ilk numara, son numara]
const bolumler: [string, string, number, number][] = [
	["Temeller", "En küçük modelden başlayıp loss, gradient ve sınıflandırmaya geçiş.", 1, 3],
	["Sinir ağı nedir", "3Blue1Brown serisinin notları: yapı, öğrenme ve ağın sınırları.", 4, 6],
	["Öğrenme ve optimizasyon", "Neden iteratif iniş, stochastic olanı ve optimizer varyantları.", 7, 10],
	["Backpropagation", "Önce sezgi, sonra zincir kuralının satır satır muhasebesi.", 11, 12],
	["Aktivasyon, init ve loss", "Doygunluk, ölçeğin ağ içinde kontrolü ve loss seçiminin gerekçesi.", 13, 17],
	["PyTorch ve dil modeli", "Broadcasting tuzakları, sampling döngüsü ve bigram'ın ağ hali.", 18, 21],
	["Devamı", "RNN'e giriş, görselleştirme ve genel tekrar.", 22, 24],
	["Ek konular", "YZ50 müfredatı dışında, kendi sorularımdan çıkan notlar: genelleme, model ayarı ve dil modeli temelleri.", 25, 99],
];

const grupla = (bas: number, son: number) =>
	posts.filter((p) => {
		const n = Number.parseInt(no(p.slug), 10);
		return n >= bas && n <= son;
	});

// Hicbir bolume dusmeyen yazi olursa sessizce kaybolmasin diye yakala.
const kapsanan = new Set(bolumler.flatMap(([, , b, s]) => grupla(b, s).map((p) => p.slug)));
const kapsanmayan = posts.filter((p) => !kapsanan.has(p.slug));
---

<MainGridLayout title="ML" description="Sıfırdan backpropagation ve dil modeli — YZ50 programı boyunca tutulan notlar.">
    <div class="card-base z-10 px-6 md:px-9 py-6 mb-4">
        <h1 class="text-3xl font-bold text-90 mb-3">ML Notları</h1>
        <p class="text-75 leading-relaxed mb-2">
            YZ50 programı boyunca tuttuğum notlar. Sıfırdan backpropagation yazmaktan başlayıp
            bir dil modeline kadar giden sırayı takip ediyor. Baştan sona okunacak şekilde
            yazıldılar — her not bir öncekinin bıraktığı yerden devam ediyor.
        </p>
        <p class="text-50 text-sm">
            {posts.length} yazı · notlar yapay zeka ile tartışılarak derlendi, hata içerebilir
        </p>
    </div>

    {kapsanmayan.length > 0 && (
        <div class="card-base z-10 px-6 md:px-9 py-6 mb-4">
            <h2 class="text-xl font-bold text-90 mb-4">Diğer</h2>
            <div class="flex flex-col gap-1">
                {kapsanmayan.map((post) => (
                    <a href={getPostUrlBySlug(post.slug)}
                       class="group btn-plain !block h-auto rounded-xl px-3 py-2 -mx-1 active:scale-[0.98]">
                        <div class="flex items-baseline gap-3">
                            <span class="text-30 font-mono text-sm shrink-0">{no(post.slug)}</span>
                            <span class="text-90 group-hover:text-[var(--primary)] font-medium transition">
                                {post.data.title.replace(/^\d{2}\s*·\s*/, "")}
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    )}

    {bolumler.map(([baslik, aciklama, bas, son]) => {
        const grup = grupla(bas, son);
        return grup.length > 0 && (
            <div class="card-base z-10 px-6 md:px-9 py-6 mb-4">
                <h2 class="text-xl font-bold text-90 mb-1">{baslik}</h2>
                <p class="text-50 text-sm mb-4">{aciklama}</p>
                <div class="flex flex-col gap-1">
                    {grup.map((post) => (
                        <a href={getPostUrlBySlug(post.slug)}
                           class="group btn-plain !block h-auto rounded-xl px-3 py-2 -mx-1 active:scale-[0.98]">
                            <div class="flex items-baseline gap-3">
                                <span class="text-30 group-hover:text-[var(--primary)] font-mono text-sm shrink-0 transition">
                                    {no(post.slug)}
                                </span>
                                <span class="text-90 group-hover:text-[var(--primary)] font-medium transition">
                                    {post.data.title.replace(/^\d{2}\s*·\s*/, "")}
                                </span>
                            </div>
                            <div class="text-50 text-sm mt-0.5 ml-[2.1rem] line-clamp-2">
                                {post.data.description}
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        );
    })}
</MainGridLayout>
